<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CSD 340 Web Development with HTML and CSS</title>
   
</head>
<body>
    <div id="container">
        <h1>Assignment 11.2: JavaScript - Part 3</h1>

        <!-- to do input oontrols -->

        <div id="input-container">
            <input type="text" id="taskInput" placeholder="Enter a task... ">
            <button type="button" id="btnAdd">Add</button>
            <button type="button" id="btnDelete">Delete Last Entry</button>
            <button type="button" id="btnSort">Sort</button>
        </div>

        <!-- container to display array contents -->
        <div id="display-container">
            <ol id="tdoList"></ol>
        </div>

        <footer>
            <p>&copy; 2026 Sengvanhpheng</p>
            <p><a href="../index.html">Back to Landing Page</a></p>
        </footer>
    </div> <!-- End of container -->

    <script>
        // Array and JavaScript logic will go here
        // array variable holding task items in memory
        let todoList = [];

        // function to add an item
        function addTask() {
            let inputVal = document.getElementId("taskInput").value;
            todoList.push(inputVal);
            alert("Added task: " + inputVal);
            displayTask();
        }

        // function to delete the last item
        function deleteTask() {
            todoList.pop();
            displayTask();
        }

        // function to sort the array
        function sortTasks() {
            todoList.sort();
            displayTasks();
        }

        // function to display the array contents on page
        function displayTasks() {
            // clear out existing list items
            let listElement = document.getElementById("todoList");
            listElement.innerHTML = "";

            // loop through each item in array
            for (let i = 0; i < todoList.length; i++) {
                // add each task as a list item <li>
                listElement.innerHTML += "<li>" todoList[i] + "</li>"
            }
        }
    </script>


</body>
</html>
